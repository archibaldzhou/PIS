# Local development / synthetic tests only. Copy to .env and replace both values.
# Docker POSTGRES_USER is a superuser; these are NOT production runtime accounts.
PIS_DB_USERNAME=pis_dev
PIS_DB_PASSWORD=replace-with-a-local-development-password
PIS_TEST_DB_USERNAME=pis_test
PIS_TEST_DB_PASSWORD=replace-with-a-local-test-password
# Spring/npm do not automatically export .env; see README before running commands.

# Optional local synthetic login. No default username/password is provided.
# Enable only after setting your own PIS_DEV_USERNAME and PIS_DEV_PASSWORD in the local environment.
PIS_DEV_AUTH_ENABLED=false
# PIS_DEV_USERNAME=
# PIS_DEV_PASSWORD=
